#!/bin/sh

echo "Ejecutando comprobaciones pre-commit..."

# Entramos en el backend porque ahi se encuentran
# la aplicacion, los tests y las dependencias Python.
cd backend || exit 1

python -m ruff check .

if [ $? -ne 0 ]; then
    echo "Commit rechazado: Ruff ha encontrado errores."
    exit 1
fi

python -m pytest tests/test_services.py -v

if [ $? -ne 0 ]; then
    echo "Commit rechazado: existen tests unitarios fallidos."
    exit 1
fi

echo "Todas las comprobaciones superadas."
exit 0